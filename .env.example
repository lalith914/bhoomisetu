# =========================================================
# BHOOMISETU PRODUCTION ENVIRONMENT
# =========================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (only if your project has not migrated yet)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only elevated key for durable payment/audit writes. NEVER expose publicly.
SUPABASE_SECRET_KEY=

# BhoomiSetu free owner/admin access
BHOOMISETU_OWNER_EMAILS=
BHOOMISETU_ACCESS_SECRET=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# Soil provider
BHOOMISETU_SOIL_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Razorpay (₹199 full intelligence access)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Open geospatial discovery/data services (no key in the current implementation)
BHOOMISETU_EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1/search
BHOOMISETU_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
NEXT_PUBLIC_BHOOMISETU_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_BHOOMISETU_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
NEXT_PUBLIC_BHOOMISETU_TERRAIN_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}

# Optional production raster processor. It receives a parcel polygon + Sentinel-2 band URLs
# and should return NDVI/NDWI/NIR/NDMI/NDBI and other numerical evidence.
BHOOMISETU_RASTER_API_URL=http://127.0.0.1:3000/api/raster

# Optional geospatial AI processor. If configured, it can replace OpenAI for the final structured analysis.
BHOOMISETU_GEO_AI_URL=

# Current build runs intelligence and reports FREE. Razorpay is retained but disabled.

# CURRENT BUILD: intelligence/report/payment gate is OFF; Razorpay routes are retained for later.
BHOOMISETU_CADASTRAL_API_URL=
